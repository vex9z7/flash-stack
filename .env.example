# Use latest for an initial trial; pin a reviewed tag or sha256 digest for long-term use.
FLASH_IMAGE=ghcr.io/flash-cards/flash:latest

# Utility image for the one-shot permissions service; may also be pinned by digest.
PERMISSIONS_IMAGE=busybox:1.37.0

# Shared by Flash and the permissions service; defaults match the upstream image.
# Changing these values does not migrate existing file ownership. Stop Flash and
# migrate ownership of existing data before starting with a different UID/GID.
FLASH_UID=100
FLASH_GID=101

# Browser-facing origin: match scheme, hostname, and port, with no path or trailing slash.
FLASH_BASE_URL=http://localhost:8437

# Relative to compose.yaml, or an absolute host path.
# Create this directory before starting; the permissions service prepares its ownership.
FLASH_DATA_PATH=./data

# Listen on the host's loopback interface by default. Container port is fixed at 8437.
FLASH_HOST_IP=127.0.0.1
FLASH_HOST_PORT=8437

# Set only when a trusted proxy controls access and overwrites this header, e.g. x-real-ip.
FLASH_CLIENT_IP_HEADER=

# Previous origins, comma-separated, for existing MCP clients after an origin change.
FLASH_PREVIOUS_BASE_URLS=
